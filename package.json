{
  "name": "skill-convert-gui",
  "version": "1.1.3",
  "description": "skill-convert Windows GUI — Drag & drop skill converter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.gatheringtech.skill-convert",
    "productName": "Skill Convert",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skill Convert"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "skill-convert.js",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}
